{
  "ReverseProxy": {
    "Routes": {
      "ruta_pagos": {
        "ClusterId": "cluster_pagos",
        "Match": { "Path": "/api/pagos/{**catch-all}" }
      }
    },
    "Clusters": {
      "cluster_pagos": {
        "LoadBalancingPolicy": "CanaryPonderada",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          }
        },
        "Metadata": { "ConsecutiveFailuresHealthPolicy.Threshold": "2" },
        "Destinations": {
          "pagos_a": {
            "Address": "https://pagos-a.interno:8443",
            "Metadata": { "Peso": "45", "Canal": "estable" }
          },
          "pagos_b": {
            "Address": "https://pagos-b.interno:8443",
            "Metadata": { "Peso": "45", "Canal": "estable" }
          },
          "pagos_c": {
            "Address": "https://pagos-c.interno:8443",
            "Metadata": { "Peso": "10", "Canal": "canary" }
          }
        }
      }
    }
  }
}
